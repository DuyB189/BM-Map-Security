{
	"name": "gis-an-ninh-trat-tu",
	"private": true,
	"version": "1.0.0",
	"description": "Phần mềm Bản đồ An ninh Trật tự Phường Bình Minh (100% Offline)",
	"author": "Công an Phường Bình Minh - Tây Ninh",
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "vite --port=3000 --host=0.0.0.0",
		"build": "vite build",
		"preview": "vite preview",
		"clean": "rm -rf dist",
		"lint": "tsc --noEmit",
		"build:electron": "vite build && electron-builder",
		"build:win": "vite build && electron-builder --win",
		"build:mac": "vite build && electron-builder --mac"
	},
	"build": {
		"appId": "com.gis.anninh",
		"productName": "Bản đồ An ninh Trật tự",
		"icon": "public/app-icon.png",
		"directories": {
			"output": "release/${version}"
		},
		"files": [
			"dist",
			"dist-electron"
		],
		"extraResources": [
			{
				"from": "phuongbinhminh.mbtiles",
				"to": "phuongbinhminh.mbtiles"
			}
		],
		"mac": {
			"icon": "public/app-icon.png",
			"target": [
				"dmg"
			]
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "build/icon.ico",
			"requestedExecutionLevel": "asInvoker",
			"artifactName": "BanDo_ANTT_BinhMinh_Setup_v${version}.${ext}"
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"allowToChangeInstallationDirectory": false,
			"deleteAppDataOnUninstall": false,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Bản đồ An ninh Trật tự",
			"installerIcon": "build/icon.ico",
			"uninstallerIcon": "build/icon.ico",
			"installerHeaderIcon": "build/icon.ico",
			"runAfterFinish": true,
			"unicode": true,
			"installerLanguages": [
				"vi_VN",
				"en_US"
			],
			"language": "1066"
		}
	},
	"dependencies": {
		"@google/genai": "^1.29.0",
		"@tailwindcss/vite": "^4.1.14",
		"@vitejs/plugin-react": "^5.0.4",
		"dotenv": "^17.2.3",
		"express": "^4.21.2",
		"lucide-react": "^0.546.0",
		"maplibre-gl": "^4.7.1",
		"motion": "^12.23.24",
		"react": "^19.0.1",
		"react-dom": "^19.0.1",
		"vite": "^6.2.3",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/node": "^22.14.0",
		"autoprefixer": "^10.4.21",
		"electron": "^42.1.0",
		"electron-builder": "^26.8.1",
		"tailwindcss": "^4.1.14",
		"tsx": "^4.21.0",
		"typescript": "~5.8.2",
		"vite": "^6.2.3",
		"vite-plugin-electron": "^0.29.1",
		"vite-plugin-electron-renderer": "^0.14.7"
	}
}
