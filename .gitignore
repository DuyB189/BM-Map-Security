.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-gyp compilation folder (https://github.com/nodejs/node-gyp)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory: snowpack-install/
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rts2_cache_*/
.wmr/

